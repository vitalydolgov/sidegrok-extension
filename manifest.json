{
  "manifest_version": 3,
  "name": "SideGrok",
  "version": "1.2.0",
  "description": "Unofficial sidebar for Grok. Not affiliated with or endorsed by SpaceXAI.",
  "browser_specific_settings": {
    "gecko": {
      "id": "grok-sidebar@grok-firefox.local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["storage"],
  "options_ui": {
    "page": "preferences.html"
  },
  "commands": {
    "toggle-sidebar": {
      "suggested_key": {
        "default": "Alt+Ctrl+A"
      },
      "description": "Show or hide the drawer"
    }
  },
  "background": {
    "scripts": ["settings.js", "extension.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://grok.com/*", "https://www.grok.com/*"],
      "js": ["settings.js", "bot-picker.js", "panel.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://grok.com/*", "https://www.grok.com/*"],
      "js": ["roster.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "sidebar_action": {
    "default_title": "Grok",
    "default_panel": "sidebar.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    },
    "open_at_install": true
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  }
}
